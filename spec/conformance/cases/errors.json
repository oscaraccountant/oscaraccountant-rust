          "code": "validation_error",
          "title": "The request is not valid",
          "detail": "The request is not valid.",
          "errors": [
            {
              "field": "date",
              "code": "invalid",
              "detail": "Enter a valid date."
            }
          ],
          "request_id": "req_conformance_1",
          "message": "400 validation_error: The request is not valid. (request req_conformance_1)"
