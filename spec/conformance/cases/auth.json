{
  "$schema": "../case.schema.json",
  "title": "Credentials",
  "description": "The credential order of clients/spec/README.md, section 1.1. Step 3, the CLI login, runs a process and is a unit test of each SDK.",
  "cases": [
    {
      "id": "auth.api-key-option",
      "description": "The api_key option goes in Authorization: Bearer.",
      "spec": [
        "1.1",
        "3.3"
      ],
      "client": {
        "base_url": "https://api.example.test",
        "api_key": "osk_test_conformance"
      },
      "origin": "https://api.example.test",
      "call": {
        "operation": "me.retrieve"
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/api/me/",
            "query": [],
            "headers": {
              "authorization": "Bearer osk_test_conformance",
              "accept": "application/json",
              "idempotency-key": null
            },
            "body": {
              "kind": "none"
            }
          },
          "response": {
            "status": 200,
            "body": {
              "kind": "json",
              "value": {
                "user": {
                  "id": "01J90000000000000000000014",
                  "email": "mock@example.com",
                  "name": "Mock User",
                  "is_staff": false,
                  "ui_mode": "simple"
                },
                "has_totp": false,
                "staff_mfa_required": false,
                "email_verified": true,
                "credential": {
                  "kind": "api_key",
                  "scopes": [
                    "read",
                    "write"
                  ],
                  "staff_key": false
                },
                "organizations": [
                  {
                    "id": "org0000001",
                    "name": "Mock Organization OÜ",
                    "role": "owner",
                    "is_member": true
                  }
                ],
                "companies": [
                  {
                    "id": "cmp0000001",
                    "organization_id": "org0000001",
                    "name": "Mock Company OÜ",
                    "registry_code": "12345678",
                    "vat_number": "EE123456789",
                    "legal_form": "ou",
                    "state": "ready"
                  }
                ],
                "features": {
                  "agent": false,
                  "inbox": false
                },
                "cli_min_version": "0.1.0"
              }
            }
          }
        }
      ],
      "expect": {
        "result": {
          "kind": "json",
          "value": {
            "user": {
              "id": "01J90000000000000000000014",
              "email": "mock@example.com",
              "name": "Mock User",
              "is_staff": false,
              "ui_mode": "simple"
            },
            "has_totp": false,
            "staff_mfa_required": false,
            "email_verified": true,
            "credential": {
              "kind": "api_key",
              "scopes": [
                "read",
