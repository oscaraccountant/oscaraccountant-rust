              ],
              "staff_key": false
            },
            "organizations": [
              {
                "id": "org0000001",
                "name": "Mock Organization OÜ",
                "role": "owner",
                "is_member": true
              }
            ],
            "companies": [
              {
                "id": "cmp0000001",
                "organization_id": "org0000001",
                "name": "Mock Company OÜ",
                "registry_code": "12345678",
                "vat_number": "EE123456789",
                "legal_form": "ou",
                "state": "ready"
              }
            ],
            "features": {
              "agent": false,
              "inbox": false
            },
            "cli_min_version": "0.1.0"
          }
        }
      }
