        "1.1"
      ],
      "client": {
        "base_url": "https://api.example.test",
        "token_provider": []
      },
      "origin": "https://api.example.test",
      "call": {
        "operation": "me.retrieve"
      },
      "exchanges": [],
      "expect": {
        "error": {
          "type": "AuthenticationError",
          "status": null
        }
      }
    },
    {
      "id": "auth.no-credential",
      "description": "With no credential at all (and no OSCAR_USE_CLI_LOGIN) the call raises AuthenticationError before any request.",
      "spec": [
        "1.1",
        "1.3"
      ],
      "client": {
        "base_url": "https://api.example.test"
      },
