                "content_type": "application/pdf",
                "size_bytes": 30,
                "sha256": "9c5d598aaf59cbb6251e3702b55eca51d18b818ea5046c2aad6919f7dd49bd51",
                "received_on": "2026-09-20",
                "core_document_id": "01J90000000000000000000218",
                "bank_transaction_ids": [
                  "01J8Z3K9Q2V4X6Y8A0B2C4D6E8"
                ],
                "uploaded_by": "uploaded_by",
                "created_at": "2026-09-27T10:00:00Z",
                "origin": null
              }
            }
          }
        }
