    {
      "id": "files.upload-every-field",
      "description": "An upload sends every field of UploadRequest the caller set: file, kind, received_on, bank_transaction_id.",
      "spec": [
        "3.8"
      ],
      "client": {
        "base_url": "https://api.example.test",
        "api_key": "osk_test_conformance"
      },
      "inject": {
        "uuids": [
          "3f1c2b7e-9d4a-4c1e-8b2f-5a6d7e8f9a01"
        ]
      },
      "origin": "https://api.example.test",
      "call": {
        "operation": "files.upload",
        "path": {
          "company_id": "cmp0000001"
        },
        "multipart": {
          "fields": {
            "kind": "receipt",
            "received_on": "2026-09-20",
            "bank_transaction_id": "01J8Z3K9Q2V4X6Y8A0B2C4D6E8"
