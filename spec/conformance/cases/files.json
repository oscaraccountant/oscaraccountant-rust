    {
      "id": "files.download-bytes",
      "description": "A download gives the bytes, the content type and the file name of Content-Disposition.",
      "spec": [
        "3.8"
      ],
      "client": {
        "base_url": "https://api.example.test",
        "api_key": "osk_test_conformance"
      },
      "origin": "https://api.example.test",
      "call": {
        "operation": "files.download",
        "path": {
          "company_id": "cmp0000001",
          "file_id": "fil0000001"
        }
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/api/companies/cmp0000001/files/fil0000001/content/",
            "query": [],
            "headers": {
              "authorization": "Bearer osk_test_conformance",
              "accept": "*/*",
              "idempotency-key": null
            },
            "body": {
              "kind": "none"
            }
          },
          "response": {
            "status": 200,
            "headers": {
              "content-type": "application/pdf",
              "content-disposition": "inline; filename=\"invoice.pdf\""
            },
            "body": {
              "kind": "base64",
              "value": "JVBERi0xLjQKJSBtb2NrIGludm9pY2UK"
            }
          }
        }
      ],
      "expect": {
        "result": {
          "kind": "binary",
          "sha256": "c5069e96d942a867e6668ba3342bcdefcdd4ba7c75e9284bf5d033877d3dee72",
          "size": 24,
          "content_type": "application/pdf",
          "filename": "invoice.pdf"
        }
      }
    },
