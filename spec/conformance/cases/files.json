          }
        }
      },
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "path": "/api/companies/cmp0000001/files/",
            "query": [],
            "headers": {
              "authorization": "Bearer osk_test_conformance",
              "accept": "application/json",
              "content-type": {
                "pattern": "^multipart/form-data; ?boundary="
              },
              "idempotency-key": "3f1c2b7e-9d4a-4c1e-8b2f-5a6d7e8f9a01"
            },
            "body": {
              "kind": "multipart",
              "parts": [
                {
                  "name": "file",
                  "filename": "receipt.pdf",
                  "content_type": "application/pdf",
                  "sha256": "9c5d598aaf59cbb6251e3702b55eca51d18b818ea5046c2aad6919f7dd49bd51"
                },
                {
                  "name": "kind",
                  "value": "receipt"
                },
                {
                  "name": "received_on",
                  "value": "2026-09-20"
                },
                {
                  "name": "bank_transaction_id",
                  "value": "01J8Z3K9Q2V4X6Y8A0B2C4D6E8"
