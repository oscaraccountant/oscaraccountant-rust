      "expect": {
        "result": {
          "kind": "json",
          "value": {
            "id": "fil0000002",
            "kind": "receipt",
            "name": "receipt.pdf",
            "content_type": "application/pdf",
            "size_bytes": 30,
            "sha256": "9c5d598aaf59cbb6251e3702b55eca51d18b818ea5046c2aad6919f7dd49bd51",
