      ],
      "request": [],
      "response": [
        "items[].id",
        "items[].person.first_name",
        "items[].person.last_name",
        "items[].role",
        "items[].role_ended",
        "items[].status",
        "items[].verification_status",
        "items[].can_start",
        "items[].pep_answered"
