    {
      "name": "submit the questionnaire",
      "method": "POST",
      "path": "/api/companies/{company_id}/compliance/questionnaire/submit/",
      "query": [],
      "request": [
        "website",
        "no_website",
        "activity_description",
        "customer_countries",
        "supplier_countries",
        "expected_turnover",
        "cash_usage",
        "uses_crypto_assets",
        "needs_licence",
        "licence_description",
        "residence",
        "residence_countries",
        "e_resident",
        "estonia_reason",
        "startup_funds_source",
