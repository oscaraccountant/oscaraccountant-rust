        "residence_countries",
        "e_resident",
        "estonia_reason",
        "startup_funds_source",
        "acts_for_others",
        "acts_for_others_reason",
        "field_experience",
        "website",
        "no_website",
        "register_website",
        "asked.estonia_reason",
        "asked.startup_funds_source",
        "register_activity",
        "register_activity_names.code",
        "register_activity_names.en",
        "done",
        "submitted_at"
      ]
    },
    {
      "name": "save the questionnaire",
      "method": "PATCH",
      "path": "/api/companies/{company_id}/compliance/questionnaire/",
      "query": [],
      "request": [
        "website",
        "no_website",
        "activity_description",
        "customer_countries",
        "supplier_countries",
        "expected_turnover",
        "cash_usage",
        "uses_crypto_assets",
        "needs_licence",
        "licence_description",
        "residence",
        "residence_countries",
        "e_resident",
        "estonia_reason",
        "startup_funds_source",
